# Copy to .env.media-stack and fill in. Used by media-management-stack.yaml
# Run: docker compose --env-file .env.media-stack -f media-management-stack.yaml up -d

# User/group the containers run as (0 = root, needed in a privileged LXC with bind mounts)
PUID=0
PGID=0
TZ=Africa/Johannesburg

# Paths
MEDIA_PATH=/mnt/storage/media
THREADFIN_DATA_PATH=./data

# Wizarr
WIZARR_DISABLE_BUILTIN_AUTH=false
