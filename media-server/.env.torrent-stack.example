# Copy to .env.torrent-stack and fill in. Used by torrent-stack.yaml
# Run: docker compose --env-file .env.torrent-stack -f torrent-stack.yaml up -d

PUID=0
PGID=0
TZ=Africa/Johannesburg

# Paths
MEDIA_PATH=/mnt/storage/media
DOWNLOADS_PATH=/mnt/downloads

# VPN (gluetun) - values come from your VPN provider's WireGuard config generator
VPN_SERVICE_PROVIDER=airvpn
VPN_TYPE=wireguard
SERVER_COUNTRIES=Netherlands
WIREGUARD_PRIVATE_KEY=changeme
WIREGUARD_PRESHARED_KEY=changeme
WIREGUARD_ADDRESSES=10.0.0.2/32
# Forwarded port(s) from the VPN provider, plus the qBittorrent web UI port
FIREWALL_VPN_INPUT_PORTS=57623,8080

# qBittorrent
QBT_WEBUI_PORT=8080

# FlareSolverr
LOG_LEVEL=info

# Watchtower: 6-field cron (sec min hour day month weekday). Default = daily at midnight
WATCHTOWER_SCHEDULE=0 0 0 * * *
